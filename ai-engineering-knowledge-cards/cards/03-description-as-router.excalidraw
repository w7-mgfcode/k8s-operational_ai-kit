      "locked": false, "roundness": {"type": 3}
    },
    {
      "type": "text", "id": "cluster_contract_text", "x": 978, "y": 514, "width": 248, "height": 126,
      "text": "cluster-doctor\nInvestigates Kubernetes cluster health.\n\nTriggers on: “pods cannot schedule”\nDo NOT use for: tracing backend\nUse tracing-backend-doctor", "originalText": "cluster-doctor\nInvestigates Kubernetes cluster health.\n\nTriggers on: “pods cannot schedule”\nDo NOT use for: tracing backend\nUse tracing-backend-doctor",
