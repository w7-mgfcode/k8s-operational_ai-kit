    {
      "type": "text", "id": "tracing_contract_text", "x": 676, "y": 514, "width": 248, "height": 126,
      "text": "tracing-backend-doctor\nDiagnoses distributed-tracing backend.\n\nTriggers on: “traces disappeared”\nDo NOT use for: cluster scheduling\nUse cluster-doctor instead", "originalText": "tracing-backend-doctor\nDiagnoses distributed-tracing backend.\n\nTriggers on: “traces disappeared”\nDo NOT use for: cluster scheduling\nUse cluster-doctor instead",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0, "seed": 320006, "version": 1, "versionNonce": 420006,
