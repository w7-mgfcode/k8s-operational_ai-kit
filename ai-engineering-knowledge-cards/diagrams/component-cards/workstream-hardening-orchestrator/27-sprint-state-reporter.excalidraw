    {"type":"text","id":"s1_title","x":40,"y":180,"width":900,"height":22,"strokeColor":"#e0f2fe","text":"① STATE FILE IN, REPORT OUT  [08 · 10 · 19]","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":271001},
    {"type":"text","id":"s1_sub","x":40,"y":207,"width":1500,"height":16,"strokeColor":"#94a3b8","text":"executed, never loaded: it reads the state file, prints a report, and exits 0 — the exit code says nothing about the sprint","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":271002},

