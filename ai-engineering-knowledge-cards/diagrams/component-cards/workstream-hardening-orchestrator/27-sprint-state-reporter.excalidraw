    {"type":"text","id":"in_t","x":302,"y":282,"width":310,"height":105,"strokeColor":"#22c55e","text":"state file path (unless initializing)\nformat: table (default) · JSON · Markdown\ncheckpoint: A · B · C\nworkstream + new status, together\ninitialize flag · repository path ·\ncluster access yes or no\noutput path (stdout otherwise)","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":271012},
