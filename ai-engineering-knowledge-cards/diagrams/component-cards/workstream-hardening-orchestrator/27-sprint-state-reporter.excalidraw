    {"type":"text","id":"s7_x","x":1090,"y":1448,"width":510,"height":30,"strokeColor":"#fecaca","text":"✗ writing falls back to JSON without the library; reading\n  falls back to a JSON parser · structural","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":277015},

    {"type":"line","id":"div4","x":40,"y":1505,"width":1560,"height":0,"points":[[0,0],[1560,0]],"strokeColor":"#64748b","strokeWidth":1,"strokeStyle":"dashed","roughness":0,"opacity":100,"seed":278001},
    {"type":"text","id":"pat_h","x":40,"y":1521,"width":400,"height":15,"strokeColor":"#93c5fd","text":"PATTERNS IT INSTANCES","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":278002},
    {"type":"text","id":"pat_t","x":40,"y":1543,"width":1560,"height":15,"strokeColor":"#94a3b8","text":"[19] Scope Lock and Checkpoint Delivery: the checkpoint report is this script's output, read from the locked state file — and the ignored argument loses what a checkpoint must carry","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":278003},
    {"type":"text","id":"missing","x":40,"y":1580,"width":1560,"height":45,"strokeColor":"#fecaca","text":"deliberately missing: a decision (a blocked-by column from the dependencies, trigger states and trigger-to-workstream mapping it already has — a dozen lines)\n· a vocabulary (an enum check on update, and on load) · checkpoint-specific reports (its deliverables, and at the last one the backlog)","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":278004},
    {"type":"text","id":"proto","x":40,"y":1630,"width":1560,"height":30,"strokeColor":"#94a3b8","text":"prototype: a fabricated mid-sprint state file; --update prints the change and saves nothing; --audit shows the identical checkpoint reports,\nthe out-of-vocabulary status and two workstreams shown as unblocked · no initializer, no write","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":278005}
