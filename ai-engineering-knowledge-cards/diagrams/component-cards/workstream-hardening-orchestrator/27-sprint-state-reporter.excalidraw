    {"type":"text","id":"out_t","x":912,"y":282,"width":410,"height":105,"strokeColor":"#22c55e","text":"table · fixed-width, workstreams only\nMarkdown · three tables: workstreams + blockers,\n  triggers + state + fallback action,\n  checkpoints + target + status\nJSON · the state file dumped\nupdate · one line + the rewritten state file\ninitialize · new state file + one-line JSON summary","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":271017},
    {"type":"text","id":"out_n","x":900,"y":408,"width":480,"height":30,"strokeColor":"#94a3b8","text":"the exit code is 0 in every successful case;\nit carries no information about the sprint","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":271018},

