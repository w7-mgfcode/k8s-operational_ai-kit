    {"type":"text","id":"s3_n","x":40,"y":1110,"width":780,"height":30,"strokeColor":"#94a3b8","text":"card 19: a checkpoint must carry its own deliverables —\nexactly what the ignored argument loses","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":273022},

