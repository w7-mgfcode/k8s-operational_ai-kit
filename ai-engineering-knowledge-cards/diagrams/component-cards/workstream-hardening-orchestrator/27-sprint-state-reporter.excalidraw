    {"type":"text","id":"subtitle","x":40,"y":82,"width":1560,"height":22,"strokeColor":"#93c5fd","text":"component card 27 · type: script · the sprint state file as a table, Markdown or JSON — it prints and decides nothing","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":270002},
