    {"type":"text","id":"out_t","x":50,"y":562,"width":1160,"height":15,"strokeColor":"#374151","text":"outputs: none of its own · its pass criteria are what a checkpoint report [09] claims was met, and what the gate runner [28] is supposed to measure","fontSize":12,"fontFamily":3,"textAlign":"center","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":191024},

