    {"type":"text","id":"s2_title","x":40,"y":630,"width":1400,"height":22,"strokeColor":"#e0f2fe","text":"② ONE GATE, TWO FILES — FOUR SAY SOMETHING DIFFERENT  [06] [28]","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":192001},
    {"type":"text","id":"s2_sub","x":40,"y":657,"width":1500,"height":16,"strokeColor":"#94a3b8","text":"the catalogue and the runner encode the same gates; the runner prints PASS or FAIL, and only blocking failures fail a workstream","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":192002},

