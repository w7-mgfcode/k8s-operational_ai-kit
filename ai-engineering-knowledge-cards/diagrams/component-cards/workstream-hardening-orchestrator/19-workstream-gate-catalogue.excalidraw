    {"type":"text","id":"title","x":40,"y":30,"width":760,"height":45,"strokeColor":"#e0f2fe","text":"Workstream Gate Catalogue","fontSize":36,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":190001},
    {"type":"text","id":"subtitle","x":40,"y":82,"width":1560,"height":22,"strokeColor":"#93c5fd","text":"component card 19 · type: reference · every gate written down once, then written again in code, where four of them differ","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":190002},
    {"type":"text","id":"summary","x":40,"y":122,"width":1560,"height":20,"strokeColor":"#94a3b8","text":"the catalogue defines every gate → the runner prints PASS or FAIL → the catalogue is only read if someone asks why","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":190003},

    {"type":"text","id":"s1_title","x":40,"y":170,"width":1200,"height":22,"strokeColor":"#e0f2fe","text":"① FOUR LAYERS, FROM EVERY CHANGE TO EVERY APPLY  [06] [17] [19]","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":191001},
    {"type":"text","id":"s1_sub","x":40,"y":197,"width":1500,"height":16,"strokeColor":"#94a3b8","text":"exit criteria are fixed per workstream before work starts, and each checkpoint report claims against them; the document half of a pair","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":191002},

