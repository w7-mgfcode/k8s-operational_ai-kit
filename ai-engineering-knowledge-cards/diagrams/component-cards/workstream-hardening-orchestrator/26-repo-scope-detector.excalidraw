    {"type":"text","id":"subtitle","x":40,"y":82,"width":1560,"height":22,"strokeColor":"#93c5fd","text":"component card 26 · type: script · a repository layout in, a pre-filled sprint state out, and the scope decisions made without asking","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":260002},
    {"type":"text","id":"summary","x":40,"y":122,"width":1560,"height":20,"strokeColor":"#94a3b8","text":"repository layout → roles, playbooks, stubs, report → every role owned · a stub read as ready · “tomorrow” for a date → state file → the user confirms it","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":260003},

