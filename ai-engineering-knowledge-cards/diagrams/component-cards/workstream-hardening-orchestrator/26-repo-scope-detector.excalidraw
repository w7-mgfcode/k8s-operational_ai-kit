    {"type":"line","id":"div4","x":40,"y":1668,"width":1560,"height":0,"points":[[0,0],[1560,0]],"strokeColor":"#64748b","strokeWidth":1,"strokeStyle":"dashed","roughness":0,"opacity":100,"seed":268001},
    {"type":"text","id":"pat_h","x":40,"y":1684,"width":400,"height":15,"strokeColor":"#93c5fd","text":"PATTERNS IT INSTANCES","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":268002},
    {"type":"text","id":"pat_t","x":40,"y":1706,"width":1560,"height":30,"strokeColor":"#94a3b8","text":"[19] Scope Lock and Checkpoint Delivery: scope frozen in a file before work starts; here it is generated rather than agreed, and two checkpoints carry no date\n[20] Repository Projection Pipeline: the layout projected into a structured artifact once, at scope lock, with no later re-detection to notice drift","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":268003},
    {"type":"text","id":"missing","x":40,"y":1754,"width":1560,"height":45,"strokeColor":"#fecaca","text":"deliberately missing: asking (the owned-role list belongs in the scope-lock conversation, not in a default) · readiness by content (a stub of only comments is not a starting point)\n· dates (checkpoint targets computed from the creation date and the sprint's day boundaries) · one plan structure (template, script and status reporter built from one definition)","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":268004},
    {"type":"text","id":"proto","x":40,"y":1802,"width":1560,"height":15,"strokeColor":"#94a3b8","text":"prototype: detects a fabricated repository and prints the pre-filled state to stdout · --audit lists seven decisions the pre-fill made without asking · nothing is written","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":268005}
