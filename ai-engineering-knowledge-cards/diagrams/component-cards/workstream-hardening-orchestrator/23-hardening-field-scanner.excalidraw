    {"type":"text","id":"s5_ev_t","x":892,"y":1275,"width":696,"height":30,"strokeColor":"#22c55e","text":"script: exempt · subagent: flagged · guide: special case\nor any other combination of the three","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":235013},
