    {"type":"text","id":"trig_t","x":50,"y":305,"width":200,"height":60,"strokeColor":"#374151","text":"run by the calling step;\nscripts table: both modes\n“check the secrets store's\nhealth” → generate mode","fontSize":12,"fontFamily":3,"textAlign":"center","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":291009},
    {"type":"text","id":"trig_n","x":40,"y":408,"width":245,"height":60,"strokeColor":"#94a3b8","text":"[20] and [19] call for a check\nafter every secrets-store change;\nneither names this script;\nthe runbook [16] has its own loop","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":291010},

