    {"type":"text","id":"in_t","x":302,"y":300,"width":310,"height":75,"strokeColor":"#22c55e","text":"mode: generate · parse\nsaved status output (for parse)\noutput path (stdout otherwise)\nconstants in the script:\n  one namespace, three pods","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":291012},
