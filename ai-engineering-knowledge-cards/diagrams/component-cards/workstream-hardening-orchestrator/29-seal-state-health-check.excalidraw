    {"type":"text","id":"title","x":40,"y":30,"width":760,"height":45,"strokeColor":"#e0f2fe","text":"Seal-State Health Checker","fontSize":36,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":290001},
    {"type":"text","id":"subtitle","x":40,"y":82,"width":1560,"height":22,"strokeColor":"#93c5fd","text":"component card 29 · type: script · two halves of one health check — one generates the commands, the other parses their output","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":290002},
    {"type":"text","id":"summary","x":40,"y":122,"width":1560,"height":20,"strokeColor":"#94a3b8","text":"generate → operator runs by hand → saved output → parse → JSON · exit 0 whatever the result · neither half reads what the other produces","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":290003},

    {"type":"text","id":"s1_title","x":40,"y":180,"width":900,"height":22,"strokeColor":"#e0f2fe","text":"① TWO MODES, ONE SCRIPT  [08 · 20 · 16]","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":291001},
    {"type":"text","id":"s1_sub","x":40,"y":207,"width":1500,"height":16,"strokeColor":"#94a3b8","text":"executed, never loaded: it generates commands for an operator and parses saved output — the script has no path that runs a cluster command","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":291002},

