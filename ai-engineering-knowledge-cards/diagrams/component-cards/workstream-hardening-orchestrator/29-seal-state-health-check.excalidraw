    {"type":"text","id":"out_t","x":912,"y":288,"width":410,"height":95,"strokeColor":"#22c55e","text":"generate · two lists: health checks +\n  the unseal procedure\nparse · per pod: sealed, HA-enabled,\n  active or standby, version\n  counts: sealed · unsealed\n  a healthy flag + a one-line summary","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":291017},
    {"type":"text","id":"out_n","x":900,"y":408,"width":480,"height":30,"strokeColor":"#94a3b8","text":"the exit code is 0 in both modes whatever the result;\nan unhealthy store exits like a healthy one","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":291018},

