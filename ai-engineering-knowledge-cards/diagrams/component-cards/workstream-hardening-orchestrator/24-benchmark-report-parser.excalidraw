   "id": "f_2",
   "x": 40,
   "y": 1640,
   "width": 709,
   "height": 30,
   "strokeColor": "#94a3b8",
   "text": "[17] Blast-Radius Gating: approval scales with what a finding touches; the scale is a prefix list,\n     and a missing prefix lowers the bar without a trace",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "roughness": 0,
   "opacity": 100,
