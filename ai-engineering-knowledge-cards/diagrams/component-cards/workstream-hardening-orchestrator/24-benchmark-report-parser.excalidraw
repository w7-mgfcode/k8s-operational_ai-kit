   "y": 1590,
   "width": 796,
   "height": 30,
   "strokeColor": "#94a3b8",
   "text": "[06] Calibrated Degrees of Freedom: parsing a fixed report format is code, and disposition is left to a human;\n     the applicability regexes move part of that human judgement into code, where nobody reviews it",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "roughness": 0,
   "opacity": 100,
   "lineHeight": 1.25,
