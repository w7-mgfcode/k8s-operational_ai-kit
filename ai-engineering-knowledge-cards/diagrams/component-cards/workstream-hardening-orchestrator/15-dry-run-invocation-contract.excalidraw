    {"type":"text","id":"subtitle","x":40,"y":82,"width":1560,"height":22,"strokeColor":"#93c5fd","text":"component card 15 · type: reference · one command shape: a check run and an apply run that differ by a single flag","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":150002},
    {"type":"text","id":"summary","x":40,"y":122,"width":1560,"height":20,"strokeColor":"#94a3b8","text":"pick the phase playbook → check run → operator reads the diff → apply run → nothing records that the check ran","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":150003},

    {"type":"text","id":"s1_title","x":40,"y":180,"width":800,"height":22,"strokeColor":"#e0f2fe","text":"① ONE COMMAND, TWICE  [06]","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":151001},
    {"type":"text","id":"s1_sub","x":40,"y":207,"width":1200,"height":16,"strokeColor":"#94a3b8","text":"a fixed template, not a description: the most fragile step, touching the cluster, gets the lowest freedom","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":151002},

