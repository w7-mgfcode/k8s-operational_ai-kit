    {"type":"text","id":"pb_note","x":40,"y":378,"width":230,"height":56,"strokeColor":"#94a3b8","text":"order is fixed, non-negotiable:\nresource definitions first,\nnetworking before services,\nsecurity before workloads","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":151009},

