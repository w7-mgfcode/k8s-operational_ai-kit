    {"type":"line","id":"div3","x":40,"y":1290,"width":1560,"height":0,"points":[[0,0],[1560,0]],"strokeColor":"#64748b","strokeWidth":1,"strokeStyle":"dashed","roughness":0,"opacity":100,"seed":155020},
    {"type":"text","id":"pat_h","x":40,"y":1306,"width":400,"height":15,"strokeColor":"#93c5fd","text":"PATTERNS IT INSTANCES","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":156001},
    {"type":"text","id":"pat_t","x":40,"y":1328,"width":1560,"height":48,"strokeColor":"#94a3b8","text":"[06] Calibrated Degrees of Freedom: the most fragile step gets a fixed command template, not a description\n[16] The Permission Ladder: generate, never run; the operator holds the apply; only the production guard is code\n[17] Blast-Radius Gating: a dry-run before every apply and a fixed phase order; tags narrow each run to one role","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":156002},
    {"type":"text","id":"missing","x":40,"y":1396,"width":1560,"height":48,"strokeColor":"#fecaca","text":"deliberately missing: a record of the check run (a wrapper that logs each check's arguments and refuses an apply without an identical one; the prototype shows it in memory)\n· operator-neutral values: the contract names variables, not values · one answer per rule: whether lint blocks, stated once","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":156003}
