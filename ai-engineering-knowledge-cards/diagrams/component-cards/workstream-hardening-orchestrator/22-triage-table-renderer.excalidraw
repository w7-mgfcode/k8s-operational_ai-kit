    {"type":"text","id":"in_t","x":52,"y":292,"width":300,"height":75,"strokeColor":"#22c55e","text":"--findings <path>  parser JSON [24]\nsummary counts + a findings list;\neach: control ID, status, description,\nclassification, likely-NA flag,\napproval flag (failures only)","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":221009},
