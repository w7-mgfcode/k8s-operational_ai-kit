    {"type":"text","id":"out_t","x":667,"y":285,"width":520,"height":90,"strokeColor":"#22c55e","text":"triage table · Markdown, or YAML with the same rows\nheader: report path + pass/fail/warn/control-plane/actionable counts\nfailures: one row each, sorted by control ID\nwarnings: a shorter table, every column TBD\nlegend: implement · defer · NA · TBD, then the decision rules\nstdout: one-line JSON with failure, warning and TBD counts","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":221014},
