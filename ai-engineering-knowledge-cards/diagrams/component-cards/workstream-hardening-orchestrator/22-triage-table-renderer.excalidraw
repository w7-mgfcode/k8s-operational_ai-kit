    {"type":"text","id":"summary","x":40,"y":122,"width":1560,"height":20,"strokeColor":"#94a3b8","text":"parser JSON → one row per failing control → NA or TBD, never implement or defer → table on disk → the gate asks only whether the file exists","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","roughness":0,"opacity":100,"lineHeight":1.25,"autoResize":false,"seed":220003},

