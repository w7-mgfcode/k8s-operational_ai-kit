   "height": 15,
   "strokeColor": "#93c5fd",
   "text": "PATTERNS IT INSTANCES",
   "originalText": "PATTERNS IT INSTANCES",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
