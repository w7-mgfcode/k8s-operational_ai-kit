  {
   "type": "text",
   "id": "pat1",
   "x": 40,
   "y": 1738,
   "width": 752,
   "height": 15,
   "strokeColor": "#94a3b8",
   "text": "[07] Capability Taxonomy: the subagent as a unit of delegated work with its own context, once per sprint",
   "fontSize": 12,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "roughness": 0,
   "opacity": 100,
   "lineHeight": 1.25,
