    {
      "type": "text", "id": "contract_text", "x": 500, "y": 260, "width": 350, "height": 95,
      "text": "THE CONTRACT\none canonical file\nrules • schemas • procedures • prohibitions\n\nThe only place policy is stated.", "originalText": "THE CONTRACT\none canonical file\nrules • schemas • procedures • prohibitions\n\nThe only place policy is stated.",
